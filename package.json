{
  "name": "ai-filesystem-mcp",
  "version": "3.0.0",
  "description": "Focused MCP server for things AI agents (Claude Code, Codex CLI, etc.) can't easily do themselves: atomic multi-file transactions, persistent file watchers, secret scanning, and password-derived file encryption.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "bin": {
    "ai-filesystem-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/proofmath-owner/ai-filesystem-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/proofmath-owner/ai-filesystem-mcp/issues"
  },
  "homepage": "https://github.com/proofmath-owner/ai-filesystem-mcp#readme",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc -w",
    "clean": "rm -rf dist",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write 'src/**/*.ts'",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "codex",
    "secret-scan",
    "file-watcher",
    "transaction",
    "encryption"
  ],
  "author": "AI FileSystem Team",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "chokidar": "^3.5.3",
    "glob": "^10.3.10"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/node": "^20.10.0",
    "eslint": "^8.56.0",
    "prettier": "^3.2.0",
    "tsx": "^4.6.0",
    "typescript": "^5.3.0"
  }
}
